# =========================================================
# Phase 0 automatically generated intermediate CSVs
#
# Keep the manually curated/frozen event files,
# but ignore large/reproducible automatic inventories.
# =========================================================

data/processed/pilot_events/*_all_events.csv
data/processed/pilot_events/*_shortlist.csv

# =========================================================
# Generated visualizations
# =========================================================

results/visualizations/

# =========================================================
# Phase 1 generated experiment outputs
#
# predictions, runtime logs, evaluation outputs, etc.
# These can be recreated by running the experiments.
# =========================================================

results/phase1/

